<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      对话请求全部由本机直连用户填的服务商地址，没有中间服务器。
      除了 INTERNET，不需要任何其他权限 —— 不读通讯录、不读存储、
      不申请后台定位。这是 BYOK 形态该有的样子。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      allowBackup 关掉。理由不是「省事」，是**开着反而更糟**：
      AndroidKeyStore 里的主密钥不可导出、不参与备份，所以换机恢复之后，
      aichat_secrets.xml 里那堆密文一把也解不开 —— AndroidKeystoreSecretStore
      解不开时会删掉那条记录并返回 null（优雅降级，不崩）。于是用户看到的是
      「会话在、服务商在、密钥全空」，发消息失败却没有任何地方提示要重填。
      **「全都丢了」比「看起来都在、其实缺一块」好。**
    -->
    <application
        android:name=".PatchbayApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Patchbay">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
