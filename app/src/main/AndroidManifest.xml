<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      对话请求全部由本机直连用户填的服务商地址，没有中间服务器。
      除了 INTERNET，不需要任何其他权限 —— 不读通讯录、不读存储、
      不申请后台定位。这是 BYOK 形态该有的样子。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      allowBackup 关掉。理由不是「省事」，是**开着反而更糟**：
      AndroidKeyStore 里的主密钥不可导出、不参与备份，所以换机恢复之后，
      patchbay_secrets.xml 里那堆密文一把也解不开 —— AndroidKeystoreSecretStore
      解不开时会删掉那条记录并返回 null（优雅降级，不崩）。于是用户看到的是
      「会话在、服务商在、密钥全空」，发消息失败却没有任何地方提示要重填。
      **「全都丢了」比「看起来都在、其实缺一块」好。**

      **但它只够一半。** Android 12 起这个属性只挡云备份，挡不住设备间迁移 ——
      官方文档（Android 12 行为变更）的原话是「specifying
      android:allowBackup="false" does disable backups to Google Drive, but
      doesn't disable D2D transfers for the app」。要控制 D2D 只能用下面的
      dataExtractionRules（逐项排除的清单和理由写在那个文件里）。
      **这两个属性是一对，缺一个就漏一半** —— 而漏掉的正是上面想防的那件事。
    -->
    <!--
      tools:ignore="DataExtractionRules" 是在回应 lint 的这句话：
      「dataExtractionRules 只对 Android 12 及以上生效；minSdk 是 28，你还应该
      设 android:fullBackupContent」。**它推荐的那个补法在这里是多余的** ——
      Android 11 及以下由上面的 allowBackup="false" 整个兜住（那个属性在老版本
      上关掉的是全部备份：云备份、D2D、adb backup 都在内）。两个属性合起来正好
      覆盖全区间，再加一份 fullBackupContent 只是多一个没人读的文件。
      抑制掉它，是为了防止后来的人照着 lint 的建议去「修」出一个多余文件。
    -->
    <application
        android:name=".PatchbayApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Patchbay"
        tools:ignore="DataExtractionRules">
        <!--
          windowSoftInputMode 在 activity 上，不在 application 上。

          这个属性只属于 AndroidManifestActivity —— SDK 的 attrs_manifest.xml 里
          `windowSoftInputMode` 只出现在那个 styleable 下（android-36 的行 3366）。
          写在 application 上 **aapt2 不报错**，还会原样进合并后的清单，但运行时
          没有任何人读它：ActivityInfo.softInputMode 只在解析 activity 时赋值。

          为什么需要它：Compose 的 imePadding() 在 API 30+ 走平台精确的 IME insets，
          和它无关；但在 **API 29 及以下**，AndroidX 只能这样近似
          （WindowInsetsCompat 里 Impl20.getInsetsForType 的 Type.IME 分支）：

              if (systemWindow.bottom > rootStable.bottom) {
                  // This handles the adjustResize case on < API 30, since
                  // systemWindow.bottom is probably going to be the IME
                  return Insets.of(0, 0, 0, systemWindow.bottom);
              }

          也就是「IME 高度 = 窗口被 resize 出来的那块底部 inset」。不声明的话
          softInputMode 是 ADJUST_UNSPECIFIED，resize 还是 pan 由系统挑；挑不到
          resize 这一支，imePadding() 就拿到 0，键盘会盖住输入框。
          minSdk 是 28，所以这不是理论问题。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
